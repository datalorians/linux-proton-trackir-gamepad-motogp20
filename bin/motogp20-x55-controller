#!/usr/bin/env python3
import ctypes
import os
import select
import signal
import sys
import time
from pathlib import Path

from evdev import AbsInfo, InputDevice, UInput, ecodes


STICK = Path(os.environ.get(
    "MOTOGP20_X55_STICK",
    "/dev/input/by-id/usb-Madcatz_Saitek_Pro_Flight_X-55_Rhino_Stick_G0013831-event-joystick",
))
STATE_DIR = Path.home() / ".local/state/motogp20-x55-controller"
PID_FILE = STATE_DIR / "adapter.pid"


def die(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def clamp(value, low, high):
    return max(low, min(high, value))


def scale(value, src_min, src_max, dst_min=-32768, dst_max=32767, invert=False):
    if src_max == src_min:
        return 0
    value = clamp(value, src_min, src_max)
    ratio = (value - src_min) / (src_max - src_min)
    if invert:
        ratio = 1.0 - ratio
    return int(dst_min + ratio * (dst_max - dst_min))


def axis_center(info):
    return (info.min + info.max) / 2.0


def split_trigger(value, info, invert=False):
    center = axis_center(info)
    span = max(center - info.min, info.max - center)
    if span <= 0:
        return 0, 0
    signed = (value - center) / span
    signed = clamp(signed, -1.0, 1.0)
    if invert:
        signed *= -1.0

    deadzone = float(os.environ.get("MOTOGP20_THROTTLE_DEADZONE", "0.06"))
    if abs(signed) < deadzone:
        return 0, 0

    magnitude = int(clamp((abs(signed) - deadzone) / (1.0 - deadzone), 0.0, 1.0) * 255)
    if signed < 0:
        return magnitude, 0
    return 0, magnitude


class OptionalTrackIR:
    def __init__(self):
        self.enabled = os.environ.get("MOTOGP20_TRACKIR", "0") == "1"
        self.lib = None
        self.ok = False
        self.last_counter = ctypes.c_uint32(0)
        self.yaw_range = float(os.environ.get("MOTOGP20_TRACKIR_YAW_DEG", "45"))
        self.pitch_range = float(os.environ.get("MOTOGP20_TRACKIR_PITCH_DEG", "30"))
        self.invert_yaw = os.environ.get("MOTOGP20_TRACKIR_INVERT_YAW", "0") == "1"
        self.invert_pitch = os.environ.get("MOTOGP20_TRACKIR_INVERT_PITCH", "0") == "1"
        self.profile = os.environ.get("MOTOGP20_TRACKIR_PROFILE", "")

    def start(self):
        if not self.enabled:
            return

        prefix = Path(os.environ.get("LINUXTRACK_PREFIX", str(Path.home() / ".local/opt/linuxtrack-trackir")))
        lib_path = Path(os.environ.get(
            "LINUXTRACK_LIB",
            str(prefix / "lib/linuxtrack/liblinuxtrack.so.0.0.0"),
        ))
        if not lib_path.exists():
            print(f"TrackIR requested but LinuxTrack library was not found: {lib_path}", file=sys.stderr)
            return

        try:
            self.lib = ctypes.CDLL(str(lib_path))
            self.init_fn = getattr(self.lib, "linuxtrack_init", None) or getattr(self.lib, "ltr_init")
            self.pose_fn = getattr(self.lib, "linuxtrack_get_pose", None) or getattr(self.lib, "ltr_get_pose")
            self.init_fn.argtypes = [ctypes.c_char_p]
            self.init_fn.restype = ctypes.c_int
            self.pose_fn.argtypes = [
                ctypes.POINTER(ctypes.c_float),
                ctypes.POINTER(ctypes.c_float),
                ctypes.POINTER(ctypes.c_float),
                ctypes.POINTER(ctypes.c_float),
                ctypes.POINTER(ctypes.c_float),
                ctypes.POINTER(ctypes.c_float),
                ctypes.POINTER(ctypes.c_uint32),
            ]
            self.pose_fn.restype = ctypes.c_int
            profile = self.profile.encode() if self.profile else None
            state = self.init_fn(profile)
            self.ok = state in (0, 1, 2)
            if self.ok:
                print("Optional TrackIR view mapping enabled.")
            else:
                print(f"TrackIR requested but linuxtrack_init returned {state}. Continuing without it.", file=sys.stderr)
        except Exception as exc:
            print(f"TrackIR requested but setup failed: {exc}. Continuing without it.", file=sys.stderr)
            self.ok = False

    def read_right_stick(self):
        if not self.ok:
            return None

        yaw = ctypes.c_float()
        pitch = ctypes.c_float()
        roll = ctypes.c_float()
        tx = ctypes.c_float()
        ty = ctypes.c_float()
        tz = ctypes.c_float()
        counter = ctypes.c_uint32()
        result = self.pose_fn(
            ctypes.byref(yaw),
            ctypes.byref(pitch),
            ctypes.byref(roll),
            ctypes.byref(tx),
            ctypes.byref(ty),
            ctypes.byref(tz),
            ctypes.byref(counter),
        )
        if result != 0:
            return None

        x = clamp(yaw.value / self.yaw_range, -1.0, 1.0)
        y = clamp(pitch.value / self.pitch_range, -1.0, 1.0)
        if self.invert_yaw:
            x *= -1.0
        if not self.invert_pitch:
            y *= -1.0
        return int(x * 32767), int(y * 32767)


def main():
    if not STICK.exists():
        die(f"Saitek X-55 Rhino stick not found: {STICK}")

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    PID_FILE.write_text(str(os.getpid()))

    stick = InputDevice(str(STICK))
    abs_x = stick.absinfo(ecodes.ABS_X)
    abs_y = stick.absinfo(ecodes.ABS_Y)
    if abs_x is None or abs_y is None:
        die("The Saitek X-55 Rhino stick does not expose ABS_X and ABS_Y.")

    invert_steer = os.environ.get("MOTOGP20_INVERT_STEER", "0") == "1"
    invert_throttle = os.environ.get("MOTOGP20_INVERT_THROTTLE", "0") == "1"

    caps = {
        ecodes.EV_KEY: [
            ecodes.BTN_SOUTH,
            ecodes.BTN_EAST,
            ecodes.BTN_NORTH,
            ecodes.BTN_WEST,
            ecodes.BTN_TL,
            ecodes.BTN_TR,
            ecodes.BTN_SELECT,
            ecodes.BTN_START,
            ecodes.BTN_MODE,
            ecodes.BTN_THUMBL,
            ecodes.BTN_THUMBR,
        ],
        ecodes.EV_ABS: [
            (ecodes.ABS_X, AbsInfo(0, -32768, 32767, 16, 128, 0)),
            (ecodes.ABS_Y, AbsInfo(0, -32768, 32767, 16, 128, 0)),
            (ecodes.ABS_RX, AbsInfo(0, -32768, 32767, 16, 128, 0)),
            (ecodes.ABS_RY, AbsInfo(0, -32768, 32767, 16, 128, 0)),
            (ecodes.ABS_Z, AbsInfo(0, 0, 255, 0, 0, 0)),
            (ecodes.ABS_RZ, AbsInfo(0, 0, 255, 0, 0, 0)),
            (ecodes.ABS_HAT0X, AbsInfo(0, -1, 1, 0, 0, 0)),
            (ecodes.ABS_HAT0Y, AbsInfo(0, -1, 1, 0, 0, 0)),
        ],
    }

    ui = UInput(
        caps,
        name="Microsoft X-Box 360 pad",
        vendor=0x045E,
        product=0x028E,
        version=0x0114,
        bustype=ecodes.BUS_USB,
    )

    trackir = OptionalTrackIR()
    trackir.start()

    running = True

    def stop(_signum, _frame):
        nonlocal running
        running = False

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    try:
        stick.grab()
    except OSError as exc:
        die(f"Could not grab Saitek X-55 Rhino stick: {exc}")

    def write_neutral():
        ui.write(ecodes.EV_ABS, ecodes.ABS_X, 0)
        ui.write(ecodes.EV_ABS, ecodes.ABS_Y, 0)
        ui.write(ecodes.EV_ABS, ecodes.ABS_RX, 0)
        ui.write(ecodes.EV_ABS, ecodes.ABS_RY, 0)
        ui.write(ecodes.EV_ABS, ecodes.ABS_Z, 0)
        ui.write(ecodes.EV_ABS, ecodes.ABS_RZ, 0)
        ui.syn()

    write_neutral()
    print("Started MotoGP 20 Saitek X-55 Rhino virtual Xbox 360 controller.")
    print("Mapping: stick left/right -> steering, stick forward/back -> accelerate/front brake.")
    if not trackir.ok:
        print("TrackIR view mapping is off. Set MOTOGP20_TRACKIR=1 to enable it.")
    print(f"PID: {os.getpid()}")
    sys.stdout.flush()

    button_map = {
        ecodes.BTN_TRIGGER: ecodes.BTN_SOUTH,
        ecodes.BTN_THUMB: ecodes.BTN_EAST,
        ecodes.BTN_THUMB2: ecodes.BTN_NORTH,
        ecodes.BTN_TOP: ecodes.BTN_WEST,
        ecodes.BTN_TOP2: ecodes.BTN_TR,
        ecodes.BTN_PINKIE: ecodes.BTN_TL,
        ecodes.BTN_BASE: ecodes.BTN_SELECT,
        ecodes.BTN_BASE2: ecodes.BTN_START,
    }

    last_trackir = 0.0
    try:
        while running:
            readable, _, _ = select.select([stick.fd], [], [], 0.01)
            for _fd in readable:
                for event in stick.read():
                    if event.type == ecodes.EV_ABS:
                        if event.code == ecodes.ABS_X:
                            steer = scale(event.value, abs_x.min, abs_x.max, -32768, 32767, invert=invert_steer)
                            ui.write(ecodes.EV_ABS, ecodes.ABS_X, steer)
                        elif event.code == ecodes.ABS_Y:
                            accel, brake = split_trigger(event.value, abs_y, invert=invert_throttle)
                            ui.write(ecodes.EV_ABS, ecodes.ABS_RZ, accel)
                            ui.write(ecodes.EV_ABS, ecodes.ABS_Z, brake)
                        elif event.code == ecodes.ABS_HAT0X:
                            ui.write(ecodes.EV_ABS, ecodes.ABS_HAT0X, event.value)
                        elif event.code == ecodes.ABS_HAT0Y:
                            ui.write(ecodes.EV_ABS, ecodes.ABS_HAT0Y, event.value)
                    elif event.type == ecodes.EV_KEY:
                        target = button_map.get(event.code)
                        if target is not None:
                            ui.write(ecodes.EV_KEY, target, event.value)
                    ui.syn()

            now = time.monotonic()
            if trackir.ok and now - last_trackir >= 1.0 / 60.0:
                view = trackir.read_right_stick()
                if view is not None:
                    ui.write(ecodes.EV_ABS, ecodes.ABS_RX, view[0])
                    ui.write(ecodes.EV_ABS, ecodes.ABS_RY, view[1])
                    ui.syn()
                last_trackir = now
    finally:
        try:
            stick.ungrab()
        finally:
            write_neutral()
            ui.close()
            try:
                PID_FILE.unlink()
            except FileNotFoundError:
                pass


if __name__ == "__main__":
    main()
